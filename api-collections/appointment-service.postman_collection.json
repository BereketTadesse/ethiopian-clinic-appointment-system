    {
      "name": "Patient",
      "description": "Login as Patient first.",
      "item": [
        {
          "name": "Book appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{appointmentBaseUrl}}/appointments",
              "host": [
                "{{appointmentBaseUrl}}"
              ],
              "path": [
                "appointments"
              ]
            },
            "description": "Patient or staff. Staff must add \"patientId\". Queue number = position in the doctor's day by appointment time.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"slotId\": \"{{slotId}}\",\n  \"date\": \"{{date}}\",\n  \"reasonForVisit\": \"Headache and fever\",\n  \"forPerson\": \"Self\",\n  \"patientName\": \"Almaz Tesfaye\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) { pm.collectionVariables.set(\"appointmentId\", res.data._id); pm.collectionVariables.set(\"cardNumber\", res.data.cardNumber); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Book for a family member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
