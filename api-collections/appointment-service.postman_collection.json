              "host": [
                "{{appointmentBaseUrl}}"
              ],
              "path": [
                "appointments"
              ]
            },
            "description": "familyMemberId must belong to the logged-in account. The member gets their own card; name/label come from the family record.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"slotId\": \"{{slotId}}\",\n  \"date\": \"{{date}}\",\n  \"familyMemberId\": \"{{familyMemberId}}\",\n  \"reasonForVisit\": \"Fever\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
