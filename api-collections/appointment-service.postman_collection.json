{
  "info": {
    "name": "Clinic - Appointment Service",
    "description": "Appointment Service (port 3003). Booking, queue, cancellation, patient cards. Get doctorId and slotId from the Clinic Service collection first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Login (run first)",
      "description": "Run one of these first. The token is stored in the collection variable {{token}} and used by every request.",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userBaseUrl}}/users/login",
              "host": [
                "{{userBaseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "description": "Saves accessToken into {{token}} automatically. Seed credentials from scripts/seed.js.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@clinic.et\",\n  \"password\": \"Admin@123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "  pm.collectionVariables.set(\"token\", res.accessToken);",
                  "  if (res.user && res.user._id) pm.collectionVariables.set(\"myUserId\", res.user._id);",
                  "  console.log(\"Saved token for role:\", res.user && res.user.role);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userBaseUrl}}/users/login",
              "host": [
                "{{userBaseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "description": "Saves accessToken into {{token}} automatically. Seed credentials from scripts/seed.js.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor.abebe@clinic.et\",\n  \"password\": \"Doctor@123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
